    "spatialnavigation-app-manage": {
      "description": "Required for toggling the cursor."
    },
    "udp-socket": {
      "description": "Required for ssdp implementation."
    },
    "systemXHR": {
      "description": "Required for ssdp implementation."
    },
    "tcp-socket": {
      "description": "Required for creating and using TCP sockets."
    },
    "donglemanager": {
      "description": "Required for obtaining the local IP address."
    }
  },
  "default_locale": "en-US",
  "locales": {
    "en-US": {
      "name": "YouTube W1.0",
      "description": "Watch, stream and discover what the world is watching with YouTube W1.0. YouTube W1.0 gives everyone a voice and a platform to discover the world. Explore brand new content, music, news and more with the official YouTube W1.0 app.",
